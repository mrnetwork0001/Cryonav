# Cryonav configuration. Every value is optional -- with none of them set the stack runs
# entirely on the deterministic microclimate simulation.

# Enables the live FortyGuard Temperature API path. Unset => simulation only.
# FORTYGUARD_API_KEY=your_key_here
# FORTYGUARD_BASE_URL=https://api.fortyguard.com

# Comma-separated CORS origins for the dashboard.
# CRYONAV_CORS_ORIGINS=http://localhost:5180

# Dev ports used by scripts/dev.sh
# CRYONAV_API_PORT=8008
# CRYONAV_WEB_PORT=5180
