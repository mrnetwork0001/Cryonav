# Cryonav configuration. Every value is optional -- with none of them set the stack runs
# entirely on the deterministic microclimate simulation.

# Enables the live FortyGuard Temperature API path. Unset => simulation only.
# FORTYGUARD_API_KEY=your_key_here
# FORTYGUARD_BASE_URL=https://api.fortyguard.com

# Comma-separated CORS origins for the dashboard.
# CRYONAV_CORS_ORIGINS=http://localhost:5180

# Dev ports used by scripts/dev.sh
# CRYONAV_API_PORT=8008
# CRYONAV_WEB_PORT=5180

# Sentinel escalation push channel (ntfy.sh). The topic name IS the secret -- anyone who
# knows it can read your alerts, so generate a random one:
#   python3 -c "import secrets; print('cryonav-alerts-' + secrets.token_hex(6))"
# Subscribe to that topic in the ntfy app on the phone that should receive alerts.
# Unset => the Sentinel still detects immobility but sends nothing, and says so in the API.
# CRYONAV_NTFY_TOPIC=cryonav-alerts-xxxxxxxxxxxx
# CRYONAV_NTFY_SERVER=https://ntfy.sh

# Peak-hour surface temperature via NASA ECOSTRESS (scripts/fetch_ecostress.py only --
# never needed at runtime). Free account: https://urs.earthdata.nasa.gov/users/new
# EARTHDATA_TOKEN=
# EARTHDATA_USERNAME=
# EARTHDATA_PASSWORD=
