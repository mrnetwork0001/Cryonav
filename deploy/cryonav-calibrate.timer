# Daily calibration refresh. Randomized delay avoids a thundering herd on FortyGuard
# if several deployments share this timer definition.
[Unit]
Description=Daily Cryonav FortyGuard calibration

[Timer]
OnCalendar=*-*-* 05:30:00 UTC
RandomizedDelaySec=15m
Persistent=true

[Install]
WantedBy=timers.target
