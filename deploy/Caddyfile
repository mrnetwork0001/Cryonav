# Cryonav edge config. deploy.sh substitutes {$CRYONAV_SITE} with your domain,
# or with :80 for bare-IP serving (no TLS without a domain).
{$CRYONAV_SITE} {
	encode zstd gzip

	# Backend: API + interactive docs
	handle /api/* {
		reverse_proxy 127.0.0.1:8008
	}
	# /docs is the product manual, served by the SPA - it is NOT Swagger any more. The API
	# reference moved under /api/docs, which the /api* handler above already covers. Proxying
	# /docs* here would shadow a real page with a 404 from the backend.
	handle /openapi.json {
		redir /api/openapi.json permanent
	}

	# Frontend: static build with SPA fallback so /app deep-links resolve
	handle {
		root * /opt/cryonav/frontend/dist
		try_files {path} /index.html
		file_server
	}
}
