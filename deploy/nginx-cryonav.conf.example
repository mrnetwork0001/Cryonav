# Cryonav behind an EXISTING nginx (when nginx already owns ports 80/443).
# Drop into /etc/nginx/sites-available/cryonav, adjust server_name, symlink to
# sites-enabled, `nginx -t`, then reload. Does not conflict with other vhosts.
server {
    listen 80;
    # listen 443 ssl;  # + your certificate directives, or use certbot --nginx
    server_name cryonav.example.com;

    root /opt/cryonav/frontend/dist;
    index index.html;

    location /api/ {
        proxy_pass http://127.0.0.1:8008;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    location = /openapi.json { proxy_pass http://127.0.0.1:8008; }
    location /docs           { proxy_pass http://127.0.0.1:8008; }

    # SPA fallback so /app deep-links resolve
    location / {
        try_files $uri $uri/ /index.html;
    }
}
